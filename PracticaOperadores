public class PracticaOperadores {
    public static void main(String[] args) {

        // 1. Suma y diferencia
        int a1 = 48, b1 = 17;
        int suma = a1 + b1;
        int diferencia = a1 - b1;
        System.out.println("1. Suma = " + suma + ", Diferencia = " + diferencia);

        // 2. Producto y cociente
        int a2 = 36, b2 = 6;
        int producto = a2 * b2;
        int cociente = a2 / b2;
        System.out.println("2. Producto = " + producto + ", Cociente = " + cociente);

        // 3. Residuo de una división
        int dividendo = 157, divisor = 12;
        int cocienteEntero = dividendo / divisor;
        int residuo = dividendo % divisor;
        System.out.println("3. Cociente Entero = " + cocienteEntero + ", Residuo = " + residuo);

        // 4. Doble, triple y mitad
        int numero4 = 24;
        int doble = numero4 * 2;
        int triple = numero4 * 3;
        double mitad = numero4 / 2.0;
        System.out.println("4. Doble = " + doble + ", Triple = " + triple + ", Mitad = " + mitad);

        // 5. Cuadrado y cubo
        int numero5 = 7;
        int cuadrado = numero5 * numero5;
        int cubo = numero5 * numero5 * numero5;
        System.out.println("5. Cuadrado = " + cuadrado + ", Cubo = " + cubo);

        // 6. Promedio de tres notas
        int nota1 = 14, nota2 = 17, nota3 = 16;
        double promedio3 = (nota1 + nota2 + nota3) / 3.0;
        System.out.println("6. Promedio = " + promedio3);

        // 7. Promedio de cuatro prácticas
        int p1 = 15, p2 = 13, p3 = 18, p4 = 16;
        double promedio4 = (p1 + p2 + p3 + p4) / 4.0;
        System.out.println("7. Promedio = " + promedio4);

        // 8. Operaciones combinadas
        int a8 = 12, b8 = 8, c8 = 4;
        double R8 = (a8 + b8) * c8 / 2.0;
        System.out.println("8. R = " + R8);

        // 9. Expresión con paréntesis
        int a9 = 20, b9 = 6, c9 = 3;
        int R9 = (a9 - b9) * (a9 + c9);
        System.out.println("9. R = " + R9);

        // 10. Expresión fraccionaria
        int a10 = 18, b10 = 7, c10 = 5;
        double R10 = (a10 + b10) / (double) c10;
        System.out.println("10. R = " + R10);
    }
}
